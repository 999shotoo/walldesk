{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-get-all-windows",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-is-maximized",
    "core:window:allow-title",
    "os:default",
    "fs:default",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "fs:allow-create",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:scope",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "*"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$PICTURE/WallDesk/**"
        }
      ]
    },
    "store:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://wallhaven.cc" }, { "url": "https://*.pexels.com" }],
      "deny": [{ "url": "https://private.tauri.app" }]
    }
  ],
    "updater:default": {
      "allow": ["allow-check", "allow-download", "allow-install", "allow-download-and-install"]
    }
  }
