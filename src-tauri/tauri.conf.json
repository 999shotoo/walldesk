{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "walldesk",
  "version": "0.1.0",
  "identifier": "com.shoto.walldesk",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "walldesk",
        "width": 1300,
        "minWidth": 1300,
        "minHeight": 820,
        "height": 820,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      },
      {
        "label": "splashscreen",
        "url": "/splashscreen",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "height": 600,
        "width": 800,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "macOS .icns icon commented out for Windows-only build",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNjQ2M0MyRDUwNzdFQTUKUldTbGZnZlZ3bU5rMGpZTm9FbVlrVStyeFN3bDhFdld4eWtxZWViZnBXNFJja29ZWmthZnFIbzAK",
      "endpoints": [
        "https://github.com/999shotoo/walldesk/releases/latest/download/latest.json"
      ],
      "active": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
