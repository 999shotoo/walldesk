{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "walldesk",
  "version": "0.1.0",
  "identifier": "com.shoto.walldesk",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "walldesk",
        "width": 1300,
        "minWidth": 1300,
        "minHeight": 820,
        "height": 820,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      },
      {
        "label": "splashscreen",
        "url": "/splashscreen",
        "decorations": false,
        "resizable": false,
        "height": 600,
        "width": 800,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
